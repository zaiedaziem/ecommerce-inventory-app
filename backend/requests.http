### Register a new customer
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
  "name": "Test User",
  "email": "test@example.com",
  "password": "password123"
}

### Login customer user
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123"
}

### Login admin user
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "adminpass123"
}

### Get current user (replace TOKEN with the token from login response)
GET http://localhost:5000/api/auth/me
Authorization: Bearer TOKEN

### Register an admin user
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
  "name": "Admin User",
  "email": "admin@example.com",
  "password": "adminpass123",
  "role": "admin"
}

### Create a category (as admin)
POST http://localhost:5000/api/categories
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "name": "Electronics",
  "description": "Gadgets and devices"
}

### Create a product (as admin)
POST http://localhost:5000/api/products
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "name": "Wireless Mouse",
  "description": "A wireless optical mouse",
  "price": 29.99,
  "stock": 50,
  "category": "6a5f39ea98d59979a4f96ad6"
}

### Get all products (public, no auth)
GET http://localhost:5000/api/products

### Get single product (public, no auth)
GET http://localhost:5000/api/products/6a5f3a1198d59979a4f96ad9

### Try creating a product as a customer (should be 403)
POST http://localhost:5000/api/products
Content-Type: application/json
Authorization: Bearer {{customer_token}}

{
  "name": "Should Fail",
  "description": "Customer shouldn't be able to create this",
  "price": 10,
  "stock": 5,
  "category": "6a5f39ea98d59979a4f96ad6"
}

### Update stock as admin
PUT http://localhost:5000/api/products/6a5f3a1198d59979a4f96ad9
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "stock": 40
}

### Try creating a product with invalid price (should be 400)
POST http://localhost:5000/api/products
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "name": "Bad Product",
  "description": "Negative price",
  "price": -5,
  "stock": 10,
  "category": "6a5f39ea98d59979a4f96ad6"
}

### Create an order (as customer)
POST http://localhost:5000/api/orders
Content-Type: application/json
Authorization: Bearer {{customer_token}}

{
  "items": [
    { "productId": "6a5f3a1198d59979a4f96ad9", "quantity": 2 }
  ]
}